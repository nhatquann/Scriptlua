        Name = "Prediction",
        CurrentValue = self.Config:Get("Prediction"),
        Flag = "Prediction",
        Callback = function(value)
            self.Config:Set("Prediction", value)
        end
    })
end

-- Настройка обработчиков изменения конфигурации
function MainController:SetupConfigHandlers()
    -- Периодическая очистка кэша предсказаний
    self.Optimizer:AddConnection(RunService.Heartbeat:Connect(function()
        if tick() % 5 < 0.1 then -- Каждые 5 секунд
            self.Prediction:CleanupCache()
        end
    end))
end

-- Защита от утечек памяти
function MainController:SetupMemoryProtection()
    -- Очистка при выходе из игры
    game:GetService("Players").LocalPlayer.OnCharacterRemoving:Connect(function()
        self.Optimizer:Cleanup()
    end)
    
    -- Автоматическая очистка неиспользуемых объектов
    self.Optimizer:AddConnection(RunService.Stepped:Connect(function()
        if #self.Optimizer.Connections > 100 then
            local toRemove = {}
            for i = 1, #self.Optimizer.Connections - 50 do
                table.insert(toRemove, i)
            end
            for _, idx in ipairs(toRemove) do
                if self.Optimizer.Connections[idx] then
                    self.Optimizer.Connections[idx]:Disconnect()
                    table.remove(self.Optimizer.Connections, idx)
                end
            end
        end
    end))
end

-- Точка входа
local Controller = MainController.new()
