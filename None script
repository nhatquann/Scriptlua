-- 1. Бесконечное здоровье
local function toggleInfiniteHealth()
    InfiniteHealthEnabled = not InfiniteHealthEnabled
    if InfiniteHealthEnabled then
        -- Зацикленное восстановление здоровья
        spawn(function()
            while InfiniteHealthEnabled do
                pcall(function()
                    local char = LocalPlayer.Character
                    if char then
                        local hum = char:FindFirstChild("Humanoid")
                        if hum then
                            hum.Health = hum.MaxHealth
                        end
                    end
                end)
                task.wait(0.1)
            end
        end)
    end
end

-- 2. Полёт с отдельным GUI
local FlyGui, FlySpeedSlider
local function toggleFly()
    FlyEnabled = not FlyEnabled
    if FlyEnabled then
        -- Создание GUI полёта
        FlyGui = Instance.new("ScreenGui")
        FlyGui.Name = "FlyControl"
        FlyGui.Parent = game.CoreGui

        local FlyFrame = Instance.new("Frame")
        FlyFrame.Size = UDim2.new(0, 200, 0, 120)
        FlyFrame.Position = UDim2.new(0, 20, 0, 200)
        FlyFrame.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
        FlyFrame.BorderSizePixel = 0
        FlyFrame.Active = true
        FlyFrame.Draggable = true
        FlyFrame.Parent = FlyGui

        local FlyTitle = Instance.new("TextLabel")
        FlyTitle.Size = UDim2.new(1, 0, 0, 30)
        FlyTitle.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
        FlyTitle.BorderSizePixel = 0
        FlyTitle.Text = "Fly Control"
        FlyTitle.TextColor3 = Color3.fromRGB(255, 255, 255)
        FlyTitle.Font = Enum.Font.SourceSansBold
        FlyTitle.TextSize = 16
        FlyTitle.Parent = FlyFrame

        -- Кнопка закрытия X
        local CloseFly = Instance.new("TextButton")
        CloseFly.Size = UDim2.new(0, 30, 0, 30)
        CloseFly.Position = UDim2.new(1, -30, 0, 0)
        CloseFly.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        CloseFly.BorderSizePixel = 0
        CloseFly.Text = "X"
        CloseFly.TextColor3 = Color3.fromRGB(255, 255, 255)
        CloseFly.Font = Enum.Font.SourceSansBold
        CloseFly.TextSize = 16
        CloseFly.Parent = FlyFrame
        CloseFly.MouseButton1Click:Connect(function()
            FlyEnabled = false
            pcall(function()
                local char = LocalPlayer.Character
                if char and char:FindFirstChild("HumanoidRootPart") then
                    -- Отключение физики полёта
                    local root = char.HumanoidRootPart
                    local bv = root:FindFirstChild("FlyVelocity")
                    if bv then bv:Destroy() end
                    local bg = root:FindFirstChild("FlyGyro")
                    if bg then bg:Destroy() end
                end
            end)
            FlyGui:Destroy()
        end)

        -- Слайдер скорости
        FlySpeedSlider = Instance.new("TextBox")
        FlySpeedSlider.Size = UDim2.new(1, -20, 0, 30)
        FlySpeedSlider.Position = UDim2.new(0, 10, 0, 40)
        FlySpeedSlider.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
        FlySpeedSlider.TextColor3 = Color3.fromRGB(255, 255, 255)
        FlySpeedSlider.BorderSizePixel = 0
        FlySpeedSlider.PlaceholderText = "Speed: 50"
        FlySpeedSlider.Text = "50"
        FlySpeedSlider.Font = Enum.Font.SourceSans
        FlySpeedSlider.TextSize = 14
        FlySpeedSlider.Parent = FlyFrame

        -- Кнопка применения скорости
        local ApplyFlySpeed = Instance.new("TextButton")
        ApplyFlySpeed.Size = UDim2.new(1, -20, 0, 25)
        ApplyFlySpeed.Position = UDim2.new(0, 10, 0, 75)
        ApplyFlySpeed.BackgroundColor3 = Color3.fromRGB(0, 170, 100)
        ApplyFlySpeed.BorderSizePixel = 0
        ApplyFlySpeed.Text = "Set Speed"
        ApplyFlySpeed.TextColor3 = Color3.fromRGB(255, 255, 255)
        ApplyFlySpeed.Font = Enum.Font.SourceSansBold
        ApplyFlySpeed.TextSize = 14
        ApplyFlySpeed.Parent = FlyFrame
        ApplyFlySpeed.MouseButton1Click:Connect(function()
            local newSpeed = tonumber(FlySpeedSlider.Text)
            if newSpeed then
                FlySpeed = newSpeed
            end
        end)

        -- Запуск физики полёта
        spawn(function()
            while FlyEnabled do
                pcall(function()
                    local char = LocalPlayer.Character
                    if char and char:FindFirstChild("HumanoidRootPart") then
                        local root = char.HumanoidRootPart
                        local hum = char:FindFirstChild("Humanoid")
                        if hum then
                            hum.PlatformStand = true
                        end
                        -- BodyVelocity для движения
                        local bv = root:FindFirstChild("FlyVelocity") or Instance.new("BodyVelocity")
                        bv.Name = "FlyVelocity"
                        bv.Velocity = Vector3.new(0, 0, 0)
                        bv.MaxForce = Vector3.new(1e6, 1e6, 1e6)
                        bv.Parent = root
                        -- BodyGyro для стабилизации
                        local bg = root:FindFirstChild("FlyGyro") or Instance.new("BodyGyro")
                        bg.Name = "FlyGyro"
                        bg.MaxTorque = Vector3.new(1e6, 1e6, 1e6)
                        bg.CFrame = root.CFrame
                        bg.Parent = root
                        -- Управление с клавиатуры
                        local moveDir = Vector3.new(0, 0, 0)
                        if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir += root.CFrame.LookVector end
                        if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir -= root.CFrame.LookVector end
                        if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir -= root.CFrame.RightVector end
                        if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir += root.CFrame.RightVector end
                        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveDir += Vector3.new(0, 1, 0) end
                        if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then moveDir -= Vector3.new(0, 1, 0) end
                        bv.Velocity = moveDir * FlySpeed
                    end
                end)
                task.wait()
            end
        end)
    else
        -- Удаление GUI и физики при выключении
        if FlyGui then FlyGui:Destroy() end
        pcall(function()
            local char = LocalPlayer.Character
            if char then
                local root = char:FindFirstChild("HumanoidRootPart")
                if root then
                    local bv = root:FindFirstChild("FlyVelocity")
                    if bv then bv:Destroy() end
                    local bg = root:FindFirstChild("FlyGyro")
                    if bg then bg:Destroy() end
                end
                local hum = char:FindFirstChild("Humanoid")
                if hum then hum.PlatformStand = false end
            end
        end)
    end
end

