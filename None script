-- 4. Бесплатные геймпассы
local function freeGamepass()
    -- Стандартный метод попытки получения геймпассов через удалённые события
    spawn(function()
        local success = false
        -- Сканируем ReplicatedStorage на наличие возможных покупок
        for _, remote in ipairs(game:GetService("ReplicatedStorage"):GetDescendants()) do
            if remote:IsA("RemoteEvent") or remote:IsA("RemoteFunction") then
                local name = remote.Name:lower()
                if name:find("gamepass") or name:find("purchase") or name:find("buy") then
                    pcall(function()
                        remote:FireServer() -- или InvokeServer
                        success = true
                    end)
                end
            end
        end
        -- Альтернатива: установка владения через бэкдор (если есть)
        if not success then
            pcall(function()
                local market = game:GetService("MarketplaceService")
                -- Пробуем дать все геймпассы игры
                for _, info in ipairs(market:GetDeveloperProductsAsync():GetCurrentPage()) do
                    pcall(function()
                        market:SignalGamepassPurchaseFinished(LocalPlayer, info.ProductId, true)
                    end)
                end
            end)
        end
        -- Уведомление
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = "Gamepass",
            Text = success and "Возможно, геймпасс активирован!" or "Метод не сработал",
            Duration = 3
        })
    end)
end

-- 5. Кастомные кнопки
local function createCustomButton(name, scriptStr)
    local btn = createMainButton(name, function()
        -- Выполнение пользовательского скрипта
        local func, err = loadstring(scriptStr)
        if func then
            spawn(func)
        else
            warn("Ошибка скрипта: " .. err)
        end
    end)
    table.insert(CustomButtons, {name = name, button = btn, script = scriptStr})
end

